{
  "name": "hexolution",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build:wasm && vite",
    "dev:host": "npm run build:wasm && vite --host",
    "build:wasm": "wasm-pack build crates/hexolution-sim --target web --out-dir pkg --release",
    "build": "npm run build:wasm && tsc -b && vite build",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:electron": "npm run build && electron-builder",
    "deploy": "npx tsx deploy.mts",
    "lint": "eslint .",
    "preview": "vite preview",
    "build-icon": "electron-icon-builder --input=./public/icon.png --output=build --flatten"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.7.1",
    "electron-builder": "^26.15.3",
    "electron-icon-builder": "^2.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-wasm": "^3.6.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.hexolution.app",
    "productName": "HEXOLUTION",
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "build/icon.icns"
    }
  }
}
