{
  "name": "@hexolution/desktop",
  "private": true,
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "dev": "npm run compile && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run compile && electron-builder",
    "start": "npm run compile && electron ."
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "cross-env": "^10.1.0",
    "electron": "^37.7.1",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.hexolution.app",
    "productName": "HEXOLUTION",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web-dist"
      }
    ],
    "mac": {
      "icon": "../web/public/icon.png"
    }
  }
}
